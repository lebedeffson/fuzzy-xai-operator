FROM python:3.11-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

WORKDIR /workspace
COPY . .
RUN python -m pip install --no-cache-dir ".[dev,evidence]"

CMD ["make", "PYTHON=python", "practical-release-check"]

