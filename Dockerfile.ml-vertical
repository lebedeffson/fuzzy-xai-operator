FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/framework/fuzzyxai \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1

COPY pyproject.toml README.md LICENSE /app/
RUN python -c 'import tomllib, pathlib; p=tomllib.loads(pathlib.Path("pyproject.toml").read_text())["project"]; pathlib.Path("ml-pipeline-requirements.txt").write_text("\n".join([*p["dependencies"], *p["optional-dependencies"]["ml-vertical"]])+"\n")' \
    && python -m pip install --no-cache-dir -r ml-pipeline-requirements.txt
COPY framework /app/framework
RUN python -m pip install --no-cache-dir --no-deps .
COPY . /app

CMD ["python", "-m", "uvicorn", "fuzzyxai.ml_vertical.api:app", "--host", "0.0.0.0", "--port", "8000"]
