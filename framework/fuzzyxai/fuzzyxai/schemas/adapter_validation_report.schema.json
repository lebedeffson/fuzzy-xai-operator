{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuzzyxai.local/schemas/adapter_validation_report.schema.json",
  "title": "FuzzyXAI runtime adapter validation report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "report_id",
    "library",
    "library_version",
    "python_version",
    "operating_system",
    "environment",
    "model_family",
    "model_class",
    "task_type",
    "adapter",
    "adapter_id",
    "sample_size",
    "prediction_parity",
    "conformance",
    "graph_validation",
    "quality_gate",
    "api_checks",
    "human_explanation_checks",
    "native_channels",
    "surrogate_channels",
    "missing_channels",
    "duration_seconds",
    "warnings",
    "status",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"type": "string", "minLength": 1},
    "library": {"type": "string", "minLength": 1},
    "library_version": {"type": "string", "minLength": 1},
    "python_version": {"type": "string", "pattern": "^3\\.(11|12)(\\.|$)"},
    "operating_system": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "model_class": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "sample_size": {"type": "integer", "minimum": 1},
    "prediction_parity": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "conformance": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "graph_validation": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "quality_gate": {"enum": ["pass", "partial", "insufficient_evidence"]},
    "api_checks": {
      "type": "object",
      "required": ["explain_one", "explain_batch", "explain_global", "why_not", "compare_models"],
      "additionalProperties": {"type": "boolean"}
    },
    "human_explanation_checks": {
      "type": "object",
      "required": [
        "decision_present",
        "reason_count_valid",
        "concern_count_valid",
        "reliability_present",
        "recommended_action_present",
        "comparisons_present",
        "all_fragments_grounded",
        "technical_terms_hidden"
      ],
      "additionalProperties": {"type": "boolean"}
    },
    "native_channels": {"type": "array", "items": {"type": "string"}},
    "derived_channels": {"type": "array", "items": {"type": "string"}},
    "surrogate_channels": {"type": "array", "items": {"type": "string"}},
    "missing_channels": {"type": "array", "items": {"type": "string"}},
    "duration_seconds": {"type": "number", "minimum": 0.0},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["pass", "failed"]},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
